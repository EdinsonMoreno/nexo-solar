# Nexo Solar - Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# Modbus Connection
NEXO_SOLAR_MODBUS_HOST=192.168.1.100
NEXO_SOLAR_MODBUS_PORT=502

# Database
NEXO_SOLAR_DB_PATH=data/nexo_solar.db

# Logging
NEXO_SOLAR_LOG_LEVEL=INFO
NEXO_SOLAR_LOG_FILE=logs/nexo_solar.log

# Encryption Key (for sensitive config values)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# NEXO_SOLAR_ENCRYPTION_KEY=
