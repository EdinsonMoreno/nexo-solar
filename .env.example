# SolarSense SCADA - Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# Modbus Connection
SOLARSENSE_MODBUS_HOST=192.168.1.100
SOLARSENSE_MODBUS_PORT=502

# Database
SOLARSENSE_DB_PATH=data/solarsense.db

# Logging
SOLARSENSE_LOG_LEVEL=INFO
SOLARSENSE_LOG_FILE=logs/solarsense.log

# Encryption Key (for sensitive config values)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# SOLARSENSE_ENCRYPTION_KEY=
